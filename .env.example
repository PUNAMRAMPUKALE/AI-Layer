# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# Required for the discovery agent (LLM-driven observe/decide/act loop).
ANTHROPIC_API_KEY=sk-ant-...

# Model used for the discovery agent. Defaults to a current Claude model with
# strong vision + tool-use if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Port the mock legacy banking app listens on.
MOCK_APP_PORT=5055

# Port the operator handoff control server listens on.
OPERATOR_PORT=5056
